{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Precisa ser igual ao nome do Worker no painel do Cloudflare.
  "name": "robson-portifolio",
  "compatibility_date": "2026-09-25",
  // Site 100% estático: o Worker só serve o que o `vite build` gera em dist/.
  "assets": {
    "directory": "./dist"
  }
}
